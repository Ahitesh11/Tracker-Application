PORT=3001
HOST=127.0.0.1
# Allowed frontend origins (the Vite proxy works with these defaults). Add your deployed frontend URL.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Supabase (required). Run supabase/schema.sql in the Supabase SQL Editor first.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# Must equal the secret inserted by supabase/schema.sql (last statement).
SUPABASE_RPC_SECRET=

# Optional AI assistant connections. Secrets belong on the backend only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_GATEWAY_API_KEY=
# Use a current provider/model ID from https://ai-gateway.vercel.sh/v1/models
AI_MODEL=
