PORT=3001
HOST=127.0.0.1
# Allowed frontend origins (the Vite proxy works with these defaults). Add your deployed frontend URL.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Supabase (required). Run supabase/schema.sql in the Supabase SQL Editor first.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# Must equal the secret inserted by supabase/schema.sql (last statement).
SUPABASE_RPC_SECRET=

# Sign-in and roles (optional). name:role:password, separated by commas. Roles: india, china, warehouse, management.
# Without APP_USERS the app is open and everyone acts as Management. With it, login is required and every action is limited by role.
APP_USERS=
# Signs the login cookie. Defaults to a value derived from SUPABASE_RPC_SECRET.
SESSION_SECRET=

# Optional AI assistant connections. Secrets belong on the backend only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_GATEWAY_API_KEY=
# Use a current provider/model ID from https://ai-gateway.vercel.sh/v1/models
AI_MODEL=

# OpenAI for chat answers and for reading receipts/messages into movement drafts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Photos of loaded / received goods (private Supabase Storage bucket "shipment-evidence", created automatically).
# Project Settings -> API -> service_role key. Backend only: never put it in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Use Supabase Authentication email/password and supabase/users.sql roles.
AUTH_PROVIDER=local
# Set AUTH_PROVIDER=supabase to require Supabase login (no APP_USERS needed).
