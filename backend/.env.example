PORT=3001
HOST=127.0.0.1
# Allowed frontend origins (the Vite proxy works with these defaults).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional absolute path. Default: backend/data/forma.sqlite
FMS_DB_FILE=
# Existing workspace.json is migrated once, without modifying the original.
# Optional AI connections. Secrets belong on the backend only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_GATEWAY_API_KEY=
# Use a current provider/model ID from https://ai-gateway.vercel.sh/v1/models
AI_MODEL=
# Google Sheets: every submitted record is pushed to this sheet (tabs Activity_Log and Products).
# Share the sheet with the service account email (Editor) and give the absolute path of its JSON key.
GOOGLE_SHEETS_SPREADSHEET_ID=1aOKO0KZB8x40Y66pSGxAqma0hr_ar1Nin09Vu4AbpKU
GOOGLE_SERVICE_ACCOUNT_FILE=C:\path\to\service-account.json
GOOGLE_DRIVE_FOLDER_ID=
# Apps Script web app (see automation/apps-script/README.md). Takes priority over the service account.
GOOGLE_APPS_SCRIPT_WEB_APP_URL=
GOOGLE_APPS_SCRIPT_SECRET=
