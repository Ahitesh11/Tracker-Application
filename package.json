{
  "name": "furniture-sourcing-fms",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run build --workspace backend && node --test backend/test/*.test.mjs frontend/test/*.test.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
